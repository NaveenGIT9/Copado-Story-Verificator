    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>copado__User_Story__c.Bypass_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>copado__User_Story__c.Bypassed_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>copado__User_Story__c.Bypassed_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Copado Story Verification Release Engineer</label>
